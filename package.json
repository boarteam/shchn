{
  "name": "shchn",
  "version": "0.1.0",
  "private": true,
  "description": "Turns live speech, requirements or code into a continuously updated YAML model of entities, properties and relations.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "shchn": "node --import tsx src/cli/cli.ts",
    "set-key": "bash scripts/set-key.sh",
    "web": "vite src/web",
    "web:build": "vite build src/web",
    "web:preview": "vite preview src/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/core && tsc --noEmit -p src/web",
    "debug:audio": "node --import tsx tools/audio-analyze.ts",
    "debug:stt": "node --import tsx tools/stt-timing.ts",
    "debug:stt-check": "node --import tsx tools/stt-check.ts",
    "debug:capture": "node --import tsx tools/capture-rate.ts",
    "debug:ffmpeg-variants": "node --import tsx tools/ffmpeg-variants.ts",
    "debug:session": "node --import tsx tools/session-report.ts",
    "debug:tts": "node --import tsx tools/tts-clip.ts",
    "debug:keys": "python3 tools/pty-keys.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
